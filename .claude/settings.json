{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/user/airline-reservation-system/scripts/hooks/pre_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/user/airline-reservation-system/scripts/hooks/post_tool_use.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
